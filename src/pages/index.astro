---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Welcome | Retro Website" showPreloader={true}>
  <div class="home-content">
    <h1 class="page-title glitch-text" data-text="WELCOME">WELCOME</h1>

    <div class="intro-section">
      <div class="ascii-art">
<pre>
   _____ _           _
  |   __| |___ _____|_|___
  |   __| | .'|     | |   |
  |__|  |_|__,|_|_|_|_|_|_|

  ╔══════════════════════════════════════╗
  ║  WELCOME TO MY DIGITAL SPACE  ║
  ╚══════════════════════════════════════╝
</pre>
      </div>

      <div class="content-box glow-box">
        <p class="typewriter">
          <span class="cursor">▌</span>
          Greetings, traveler of the information superhighway!
        </p>
        <p style="margin-top: 15px;">
          You've stumbled upon my corner of the web — a nostalgic tribute to the
          golden age of Flash websites. Here you'll find my thoughts, articles,
          and random notes about things I find interesting.
        </p>
      </div>

      <div class="quick-links">
        <h2 class="section-title">// QUICK ACCESS</h2>
        <div class="link-grid">
          <a href={`${import.meta.env.BASE_URL}about/`} class="quick-link" data-nav>
            <span class="link-icon">👤</span>
            <span class="link-text">ABOUT ME</span>
          </a>
          <a href={`${import.meta.env.BASE_URL}articles/`} class="quick-link" data-nav>
            <span class="link-icon">📝</span>
            <span class="link-text">ARTICLES</span>
          </a>
          <a href={`${import.meta.env.BASE_URL}notes/`} class="quick-link" data-nav>
            <span class="link-icon">📌</span>
            <span class="link-text">NOTES</span>
          </a>
        </div>
      </div>

      <div class="visitor-counter">
        <span class="counter-label">VISITORS:</span>
        <span class="counter-display" id="visitorCount">000000</span>
      </div>
    </div>
  </div>

  <style>
    .home-content {
      text-align: center;
    }

    .ascii-art {
      margin: 20px 0;
      font-family: monospace;
      font-size: 10px;
      color: var(--color-primary);
      text-shadow: 0 0 10px var(--color-primary);
      line-height: 1.2;
      overflow: hidden;
    }

    .ascii-art pre {
      display: inline-block;
      text-align: left;
    }

    .intro-section {
      max-width: 700px;
      margin: 0 auto;
    }

    .glow-box {
      border: 1px solid var(--color-primary);
      box-shadow:
        0 0 10px rgba(0, 255, 255, 0.2),
        inset 0 0 30px rgba(0, 255, 255, 0.05);
    }

    .typewriter {
      font-size: 20px;
      color: var(--color-primary);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
    }

    .cursor {
      animation: blink 1s infinite;
    }

    @keyframes blink {
      0%, 50% { opacity: 1; }
      51%, 100% { opacity: 0; }
    }

    .section-title {
      font-family: var(--font-tech);
      font-size: 14px;
      color: var(--color-secondary);
      margin: 30px 0 15px;
      letter-spacing: 3px;
    }

    .link-grid {
      display: flex;
      justify-content: center;
      gap: 20px;
      flex-wrap: wrap;
    }

    .quick-link {
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 20px 30px;
      background: linear-gradient(145deg, rgba(40, 40, 60, 0.8), rgba(20, 20, 30, 0.9));
      border: 2px solid #444;
      border-radius: 10px;
      text-decoration: none;
      transition: all 0.3s ease;
    }

    .quick-link:hover {
      border-color: var(--color-primary);
      transform: translateY(-5px) scale(1.05);
      box-shadow:
        0 15px 30px rgba(0, 255, 255, 0.3),
        0 0 30px rgba(0, 255, 255, 0.2);
    }

    .link-icon {
      font-size: 32px;
      margin-bottom: 10px;
    }

    .link-text {
      font-family: var(--font-tech);
      font-size: 12px;
      color: var(--color-text);
      letter-spacing: 2px;
    }

    .visitor-counter {
      margin-top: 40px;
      padding: 15px;
      background: #111;
      border: 2px solid #333;
      border-radius: 5px;
      display: inline-block;
    }

    .counter-label {
      font-family: var(--font-pixel);
      font-size: 10px;
      color: #666;
      margin-right: 10px;
    }

    .counter-display {
      font-family: 'Courier New', monospace;
      font-size: 20px;
      color: #00ff00;
      background: #000;
      padding: 5px 10px;
      border: 1px solid #333;
      text-shadow: 0 0 10px #00ff00;
    }

    .glitch-text {
      position: relative;
    }

    .glitch-text::before,
    .glitch-text::after {
      content: attr(data-text);
      position: absolute;
      left: 0;
      width: 100%;
    }

    .glitch-text::before {
      animation: glitch-1 0.3s infinite linear alternate-reverse;
      color: var(--color-secondary);
      z-index: -1;
    }

    .glitch-text::after {
      animation: glitch-2 0.3s infinite linear alternate-reverse;
      color: var(--color-accent);
      z-index: -2;
    }

    @keyframes glitch-1 {
      0% { clip-path: inset(20% 0 60% 0); transform: translate(-3px, 0); }
      100% { clip-path: inset(50% 0 20% 0); transform: translate(3px, 0); }
    }

    @keyframes glitch-2 {
      0% { clip-path: inset(60% 0 10% 0); transform: translate(3px, 0); }
      100% { clip-path: inset(10% 0 70% 0); transform: translate(-3px, 0); }
    }

    @media (max-width: 768px) {
      .ascii-art {
        font-size: 6px;
      }
    }
  </style>

  <script>
    // Fake visitor counter that increments
    const counter = document.getElementById('visitorCount');
    if (counter) {
      let count = parseInt(localStorage.getItem('fakeVisitors') || '12847');
      count += Math.floor(Math.random() * 3) + 1;
      localStorage.setItem('fakeVisitors', String(count));
      counter.textContent = String(count).padStart(6, '0');
    }
  </script>
</Layout>
