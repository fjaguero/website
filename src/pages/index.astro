---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout title="Welcome" filename="index.htm">
  <h1>Welcome to My Website!</h1>

  <hr />

  <div class="welcome-box">
    <h2>Greetings, visitor!</h2>
    <p>
      Welcome to my personal corner of the World Wide Web! This site was created using
      <strong>Microsoft FrontPage 2000</strong> and contains information about me,
      my articles, and various notes I've collected.
    </p>
  </div>

  <p>
    You have reached the personal homepage of a web enthusiast. Feel free to browse
    around using the folder list on the left, or use the quick links below!
  </p>

  <hr />

  <h2>Site Navigation</h2>

  <div class="fp-nav-bar">
    <a href={`${base}about/`} class="fp-nav-btn">◀ About Me</a>
    <a href={`${base}articles/`} class="fp-nav-btn">📝 Articles</a>
    <a href={`${base}notes/`} class="fp-nav-btn">📌 Notes</a>
  </div>

  <hr />

  <h2>What's New?</h2>

  <ul>
    <li><strong>January 2024</strong> - Added new articles about web design!</li>
    <li><strong>January 2024</strong> - Created notes section with code snippets</li>
    <li><strong>January 2024</strong> - Site launched! 🎉</li>
  </ul>

  <hr />

  <p style="text-align: center;">
    <em>You are visitor number:</em><br />
    <span class="visitor-counter" id="visitorCount">000000</span>
  </p>

  <hr />

  <div class="under-construction">
    🚧 This site is under construction! 🚧
  </div>

  <p style="text-align: center; margin-top: 20px;">
    <span class="frontpage-badge">
      📄 Created with Microsoft FrontPage
    </span>
  </p>

  <script>
    const counter = document.getElementById('visitorCount');
    if (counter) {
      let count = parseInt(localStorage.getItem('fakeVisitors') || '12847');
      count += Math.floor(Math.random() * 3) + 1;
      localStorage.setItem('fakeVisitors', String(count));
      counter.textContent = String(count).padStart(6, '0');
    }
  </script>
</Layout>
