---
import Layout from '../../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;

const articles = [
  {
    slug: 'why-flash-was-great',
    title: 'Why Flash Was Actually Great',
    date: '2024-01-15',
  },
  {
    slug: 'retro-web-design',
    title: 'Bringing Back Retro Web Design',
    date: '2024-01-10',
  },
  {
    slug: 'css-animations-guide',
    title: 'CSS Animations: A Complete Guide',
    date: '2024-01-05',
  },
];
---

<Layout title="Articles" filename="articles/index.htm">
  <h1>Articles</h1>

  <hr />

  <p>
    Welcome to my articles section! Here you'll find longer writings about web development,
    design, and other topics that interest me.
  </p>

  <hr />

  <h2>Article Index</h2>

  <ul class="file-listing">
    {articles.map((article) => (
      <li>
        <a href={`${base}articles/${article.slug}/`}>
          <span class="file-icon">📄</span>
          {article.title}
          <span class="file-date">{article.date}</span>
        </a>
      </li>
    ))}
  </ul>

  <hr />

  <div class="fp-nav-bar">
    <a href={`${base}`} class="fp-nav-btn">◀ Back to Home</a>
    <a href={`${base}notes/`} class="fp-nav-btn">View Notes ▶</a>
  </div>
</Layout>
