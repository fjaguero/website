---
import Layout from '../../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout title="My Terminal Aliases | Notes">
  <article class="note-page">
    <header class="note-header">
      <a href={`${base}notes/`} class="back-link">← Back to Notes</a>
      <h1 class="page-title">My Terminal Aliases</h1>
      <div class="note-meta">
        <span>📅 January 12, 2024</span>
        <span class="tag">#terminal</span>
        <span class="tag">#productivity</span>
      </div>
    </header>

    <div class="note-body content-box">
      <p>Aliases I use daily. Add to your <code>.zshrc</code> or <code>.bashrc</code>:</p>

      <h2>Git shortcuts</h2>
      <div class="code-box">
        <pre><code>alias gs='git status'
alias ga='git add'
alias gc='git commit -m'
alias gp='git push'
alias gl='git log --oneline -10'
alias gd='git diff'</code></pre>
      </div>

      <h2>Navigation</h2>
      <div class="code-box">
        <pre><code>alias ..='cd ..'
alias ...='cd ../..'
alias ll='ls -la'
alias projects='cd ~/projects'</code></pre>
      </div>

      <h2>Dev servers</h2>
      <div class="code-box">
        <pre><code>alias serve='python -m http.server 8000'
alias nr='npm run'
alias nrd='npm run dev'</code></pre>
      </div>

      <h2>Fun</h2>
      <div class="code-box">
        <pre><code>alias matrix='cmatrix -b -s'
alias weather='curl wttr.in'</code></pre>
      </div>
    </div>

    <footer class="note-footer">
      <a href={`${base}notes/`} class="nav-btn">← More Notes</a>
    </footer>
  </article>

  <style>
    .note-page { max-width: 700px; margin: 0 auto; }
    .note-header { margin-bottom: 30px; }
    .back-link { display: inline-block; font-family: var(--font-terminal); font-size: 14px; color: #666; text-decoration: none; margin-bottom: 20px; transition: color 0.2s; }
    .back-link:hover { color: var(--color-accent); }
    .note-meta { display: flex; gap: 15px; justify-content: center; align-items: center; font-size: 14px; color: #666; margin-top: 15px; flex-wrap: wrap; }
    .tag { font-family: var(--font-terminal); font-size: 11px; color: var(--color-primary); background: rgba(0, 255, 255, 0.1); padding: 3px 8px; border-radius: 3px; }
    .note-body { font-size: 16px; line-height: 1.7; }
    .note-body p { margin-bottom: 15px; color: #ccc; }
    .note-body code { background: #111; padding: 2px 6px; border-radius: 3px; font-family: 'Courier New', monospace; font-size: 14px; color: var(--color-accent); }
    .note-body h2 { font-family: var(--font-tech); font-size: 16px; color: var(--color-accent); margin: 25px 0 10px; }
    .code-box { background: #0a0a0f; border: 1px solid #333; border-radius: 5px; padding: 15px; margin: 10px 0 20px; overflow-x: auto; }
    .code-box pre { margin: 0; font-family: 'Courier New', monospace; font-size: 13px; color: #0f0; }
    .note-footer { margin-top: 40px; padding-top: 20px; border-top: 1px solid #333; text-align: center; }
  </style>
</Layout>
