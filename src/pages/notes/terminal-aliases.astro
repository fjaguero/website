---
import Layout from '../../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout title="Terminal Aliases" filename="notes/terminal.htm">
  <p><a href={`${base}notes/`} class="back-link">← Back to Notes</a></p>

  <h1>My Terminal Aliases</h1>

  <p><em>January 12, 2024</em></p>

  <hr />

  <p>Shell aliases that save me time every day. Add to your <code>.zshrc</code> or <code>.bashrc</code>:</p>

  <h2>Git Shortcuts</h2>

  <pre>alias gs='git status'
alias ga='git add'
alias gc='git commit -m'
alias gp='git push'
alias gl='git log --oneline -10'</pre>

  <h2>Navigation</h2>

  <pre>alias ..='cd ..'
alias ...='cd ../..'
alias ll='ls -la'</pre>

  <h2>Dev Servers</h2>

  <pre>alias serve='python -m http.server 8000'
alias nr='npm run'
alias nrd='npm run dev'</pre>

  <hr />

  <div class="fp-nav-bar">
    <a href={`${base}notes/`} class="fp-nav-btn">◀ Back to Notes</a>
  </div>
</Layout>
