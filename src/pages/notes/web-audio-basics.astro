---
import Layout from '../../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;

const codeSetup = `const audioCtx = new AudioContext();

function playTone(freq, duration) {
  const osc = audioCtx.createOscillator();
  const gain = audioCtx.createGain();

  osc.connect(gain);
  gain.connect(audioCtx.destination);

  osc.frequency.value = freq;
  osc.type = 'square'; // retro!

  gain.gain.setValueAtTime(0.1, audioCtx.currentTime);
  gain.gain.exponentialRampToValueAtTime(
    0.01, audioCtx.currentTime + duration
  );

  osc.start();
  osc.stop(audioCtx.currentTime + duration);
}`;

const codeExamples = `// Click sound
playTone(400, 0.1);

// Hover beep
playTone(800, 0.05);

// Power up
playTone(200, 0.1);
setTimeout(() => playTone(400, 0.1), 100);
setTimeout(() => playTone(800, 0.2), 200);`;
---

<Layout title="Web Audio API Basics | Notes">
  <article class="note-page">
    <header class="note-header">
      <a href={`${base}notes/`} class="back-link">← Back to Notes</a>
      <h1 class="page-title">Web Audio API Basics</h1>
      <div class="note-meta">
        <span>📅 January 3, 2024</span>
        <span class="tag">#audio</span>
        <span class="tag">#javascript</span>
      </div>
    </header>

    <div class="note-body content-box">
      <p>Make retro bleeps and bloops without any audio files!</p>

      <h2>Basic setup</h2>
      <div class="code-box">
        <pre><code set:html={codeSetup} /></pre>
      </div>

      <h2>Oscillator types</h2>
      <ul class="type-list">
        <li><code>sine</code> — Smooth, pure tone</li>
        <li><code>square</code> — Classic 8-bit sound</li>
        <li><code>sawtooth</code> — Buzzy, synth-like</li>
        <li><code>triangle</code> — Soft, mellow</li>
      </ul>

      <h2>Example sounds</h2>
      <div class="code-box">
        <pre><code set:html={codeExamples} /></pre>
      </div>

      <p><strong>Note:</strong> AudioContext must be created after user interaction (click/keypress) due to browser autoplay policies.</p>
    </div>

    <footer class="note-footer">
      <a href={`${base}notes/`} class="nav-btn">← More Notes</a>
    </footer>
  </article>

  <style>
    .note-page { max-width: 700px; margin: 0 auto; }
    .note-header { margin-bottom: 30px; }
    .back-link { display: inline-block; font-family: var(--font-terminal); font-size: 14px; color: #666; text-decoration: none; margin-bottom: 20px; transition: color 0.2s; }
    .back-link:hover { color: var(--color-accent); }
    .note-meta { display: flex; gap: 15px; justify-content: center; align-items: center; font-size: 14px; color: #666; margin-top: 15px; flex-wrap: wrap; }
    .tag { font-family: var(--font-terminal); font-size: 11px; color: var(--color-primary); background: rgba(0, 255, 255, 0.1); padding: 3px 8px; border-radius: 3px; }
    .note-body { font-size: 16px; line-height: 1.7; }
    .note-body p { margin-bottom: 15px; color: #ccc; }
    .note-body strong { color: var(--color-accent); }
    .note-body code { background: #111; padding: 2px 6px; border-radius: 3px; font-family: 'Courier New', monospace; font-size: 14px; color: var(--color-accent); }
    .note-body h2 { font-family: var(--font-tech); font-size: 16px; color: var(--color-accent); margin: 25px 0 10px; }
    .code-box { background: #0a0a0f; border: 1px solid #333; border-radius: 5px; padding: 15px; margin: 10px 0 20px; overflow-x: auto; }
    .code-box pre { margin: 0; font-family: 'Courier New', monospace; font-size: 13px; color: #0f0; }
    .note-footer { margin-top: 40px; padding-top: 20px; border-top: 1px solid #333; text-align: center; }
    .type-list { margin: 15px 0; padding-left: 20px; }
    .type-list li { margin-bottom: 8px; color: #bbb; }
  </style>
</Layout>
