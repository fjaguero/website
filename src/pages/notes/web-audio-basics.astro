---
import Layout from '../../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout title="Web Audio Basics" filename="notes/audio.htm">
  <p><a href={`${base}notes/`} class="back-link">← Back to Notes</a></p>

  <h1>Web Audio API Basics</h1>

  <p><em>January 3, 2024</em></p>

  <hr />

  <p>Make retro bleeps and bloops without any audio files!</p>

  <h2>Basic Setup</h2>

  <pre>const audioCtx = new AudioContext();

function playTone(freq, duration) &#123;
  const osc = audioCtx.createOscillator();
  const gain = audioCtx.createGain();

  osc.connect(gain);
  gain.connect(audioCtx.destination);

  osc.frequency.value = freq;
  osc.type = 'square'; // retro!

  osc.start();
  osc.stop(audioCtx.currentTime + duration);
&#125;</pre>

  <h2>Oscillator Types</h2>

  <ul>
    <li><code>sine</code> — Smooth, pure tone</li>
    <li><code>square</code> — Classic 8-bit sound</li>
    <li><code>sawtooth</code> — Buzzy, synth-like</li>
    <li><code>triangle</code> — Soft, mellow</li>
  </ul>

  <p>
    <strong>Note:</strong> AudioContext must be created after user interaction
    due to browser autoplay policies.
  </p>

  <hr />

  <div class="fp-nav-bar">
    <a href={`${base}notes/`} class="fp-nav-btn">◀ Back to Notes</a>
  </div>
</Layout>
