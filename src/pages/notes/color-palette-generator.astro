---
import Layout from '../../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout title="Color Palette" filename="notes/colors.htm">
  <p><a href={`${base}notes/`} class="back-link">← Back to Notes</a></p>

  <h1>Color Palette Generator</h1>

  <p><em>January 8, 2024</em></p>

  <hr />

  <p>Quick reference for creating retro/cyberpunk color palettes using HSL.</p>

  <h2>Classic Neon Colors</h2>

  <ul>
    <li><strong>Cyan:</strong> hsl(180, 100%, 50%) - #00FFFF</li>
    <li><strong>Magenta:</strong> hsl(300, 100%, 50%) - #FF00FF</li>
    <li><strong>Yellow:</strong> hsl(60, 100%, 50%) - #FFFF00</li>
    <li><strong>Hot Pink:</strong> hsl(330, 100%, 40%) - #CC0066</li>
  </ul>

  <h2>The Formula</h2>

  <p>For neon colors: full saturation (100%), 50% lightness</p>

  <pre>--neon-cyan: hsl(180, 100%, 50%);
--neon-magenta: hsl(300, 100%, 50%);
--bg-dark: hsl(240, 20%, 5%);</pre>

  <hr />

  <div class="fp-nav-bar">
    <a href={`${base}notes/`} class="fp-nav-btn">◀ Back to Notes</a>
  </div>
</Layout>
