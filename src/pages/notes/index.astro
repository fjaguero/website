---
import Layout from '../../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;

const notes = [
  { slug: 'gsap-quick-tips', title: 'GSAP Quick Tips', date: '2024-01-14' },
  { slug: 'terminal-aliases', title: 'My Terminal Aliases', date: '2024-01-12' },
  { slug: 'color-palette-generator', title: 'Color Palette Generator', date: '2024-01-08' },
  { slug: 'web-audio-basics', title: 'Web Audio API Basics', date: '2024-01-03' },
];
---

<Layout title="Notes" filename="notes/index.htm">
  <h1>Notes</h1>

  <hr />

  <p>
    Quick thoughts, code snippets, and things I've learned. Less polished than articles,
    but hopefully still useful!
  </p>

  <hr />

  <h2>Notes Index</h2>

  <ul class="file-listing">
    {notes.map((note) => (
      <li>
        <a href={`${base}notes/${note.slug}/`}>
          <span class="file-icon">📝</span>
          {note.title}
          <span class="file-date">{note.date}</span>
        </a>
      </li>
    ))}
  </ul>

  <hr />

  <div class="fp-nav-bar">
    <a href={`${base}`} class="fp-nav-btn">◀ Back to Home</a>
    <a href={`${base}articles/`} class="fp-nav-btn">View Articles ▶</a>
  </div>
</Layout>
