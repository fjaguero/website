---
import '../styles/global.css';

interface Props {
  title: string;
  filename?: string;
}

const { title, filename = 'index.htm' } = Astro.props;
const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL;

// Determine which "file" is selected in the tree
const isHome = currentPath === base || currentPath === `${base}` || currentPath.endsWith('/website/');
const isAbout = currentPath.includes('/about');
const isArticles = currentPath.includes('/articles');
const isNotes = currentPath.includes('/notes');
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="A personal website made with Microsoft FrontPage 2000" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title} - Microsoft FrontPage</title>
  </head>
  <body>
    <div class="frontpage-window">
      <!-- Title Bar -->
      <div class="title-bar">
        <span class="title-bar-icon">📄</span>
        <span class="title-bar-text">Microsoft FrontPage - C:\My Webs\mywebsite\{filename}</span>
        <div class="title-bar-controls">
          <button class="title-bar-btn">_</button>
          <button class="title-bar-btn">□</button>
          <button class="title-bar-btn">×</button>
        </div>
      </div>

      <!-- Menu Bar -->
      <div class="menu-bar">
        <span class="menu-item"><u>F</u>ile</span>
        <span class="menu-item"><u>E</u>dit</span>
        <span class="menu-item"><u>V</u>iew</span>
        <span class="menu-item"><u>I</u>nsert</span>
        <span class="menu-item">F<u>o</u>rmat</span>
        <span class="menu-item"><u>T</u>ools</span>
        <span class="menu-item">T<u>a</u>ble</span>
        <span class="menu-item">Fra<u>m</u>es</span>
        <span class="menu-item"><u>W</u>indow</span>
        <span class="menu-item"><u>H</u>elp</span>
      </div>

      <!-- Toolbar 1 -->
      <div class="toolbar">
        <button class="toolbar-btn" title="New">📄</button>
        <button class="toolbar-btn" title="Open">📂</button>
        <button class="toolbar-btn" title="Save">💾</button>
        <span class="toolbar-separator"></span>
        <button class="toolbar-btn" title="Publish">🌐</button>
        <span class="toolbar-separator"></span>
        <button class="toolbar-btn" title="Print">🖨️</button>
        <button class="toolbar-btn" title="Preview">👁️</button>
        <span class="toolbar-separator"></span>
        <button class="toolbar-btn" title="Cut">✂️</button>
        <button class="toolbar-btn" title="Copy">📋</button>
        <button class="toolbar-btn" title="Paste">📎</button>
        <span class="toolbar-separator"></span>
        <button class="toolbar-btn" title="Undo">↩️</button>
        <button class="toolbar-btn" title="Redo">↪️</button>
        <span class="toolbar-separator"></span>
        <button class="toolbar-btn" title="Insert Hyperlink">🔗</button>
        <button class="toolbar-btn" title="Insert Picture">🖼️</button>
      </div>

      <!-- Toolbar 2 - Formatting -->
      <div class="toolbar">
        <select class="toolbar-dropdown font-dropdown">
          <option>Comic Sans MS</option>
          <option>Times New Roman</option>
          <option>Arial</option>
          <option>Verdana</option>
          <option>Courier New</option>
        </select>
        <select class="toolbar-dropdown size-dropdown">
          <option>3 (12pt)</option>
          <option>1 (8pt)</option>
          <option>2 (10pt)</option>
          <option>4 (14pt)</option>
          <option>5 (18pt)</option>
          <option>6 (24pt)</option>
          <option>7 (36pt)</option>
        </select>
        <span class="toolbar-separator"></span>
        <button class="toolbar-btn" title="Bold"><b>B</b></button>
        <button class="toolbar-btn" title="Italic"><i>I</i></button>
        <button class="toolbar-btn" title="Underline"><u>U</u></button>
        <span class="toolbar-separator"></span>
        <button class="toolbar-btn" title="Align Left">⬅️</button>
        <button class="toolbar-btn" title="Center">⬜</button>
        <button class="toolbar-btn" title="Align Right">➡️</button>
        <span class="toolbar-separator"></span>
        <button class="toolbar-btn" title="Bullets">•</button>
        <button class="toolbar-btn" title="Numbering">#</button>
        <span class="toolbar-separator"></span>
        <button class="toolbar-btn" title="Font Color">🎨</button>
        <button class="toolbar-btn" title="Highlight">✏️</button>
      </div>

      <!-- Main Area -->
      <div class="main-area">
        <!-- Views Panel -->
        <div class="views-panel">
          <div class="views-title">Views</div>
          <a href={`${base}`} class={`view-btn ${isHome ? 'active' : ''}`}>
            <span class="view-btn-icon">📄</span>
            <span>Page</span>
          </a>
          <a href={`${base}`} class="view-btn">
            <span class="view-btn-icon">📁</span>
            <span>Folders</span>
          </a>
          <div class="view-btn">
            <span class="view-btn-icon">📊</span>
            <span>Reports</span>
          </div>
          <div class="view-btn">
            <span class="view-btn-icon">🗺️</span>
            <span>Navigation</span>
          </div>
          <div class="view-btn">
            <span class="view-btn-icon">🔗</span>
            <span>Hyperlinks</span>
          </div>
          <div class="view-btn">
            <span class="view-btn-icon">📝</span>
            <span>Tasks</span>
          </div>
        </div>

        <!-- Folder List -->
        <div class="folder-panel">
          <div class="folder-header">Folder List</div>
          <div class="folder-tree">
            <div class="tree-item">
              <span class="tree-expand">▼</span>
              <span class="tree-icon">📁</span>
              C:\My Webs\mywebsite
            </div>
            <a href={`${base}`} class={`tree-item ${isHome ? 'selected' : ''}`}>
              <span class="tree-indent"></span>
              <span class="tree-icon">📄</span>
              index.htm
            </a>
            <a href={`${base}about/`} class={`tree-item ${isAbout ? 'selected' : ''}`}>
              <span class="tree-indent"></span>
              <span class="tree-icon">📄</span>
              about.htm
            </a>
            <div class="tree-item">
              <span class="tree-indent"></span>
              <span class="tree-expand">▼</span>
              <span class="tree-icon">📁</span>
              articles
            </div>
            <a href={`${base}articles/`} class={`tree-item ${isArticles && currentPath.endsWith('/articles/') ? 'selected' : ''}`}>
              <span class="tree-indent"></span>
              <span class="tree-indent"></span>
              <span class="tree-icon">📄</span>
              index.htm
            </a>
            <a href={`${base}articles/why-flash-was-great/`} class={`tree-item ${currentPath.includes('why-flash') ? 'selected' : ''}`}>
              <span class="tree-indent"></span>
              <span class="tree-indent"></span>
              <span class="tree-icon">📄</span>
              flash.htm
            </a>
            <a href={`${base}articles/retro-web-design/`} class={`tree-item ${currentPath.includes('retro-web') ? 'selected' : ''}`}>
              <span class="tree-indent"></span>
              <span class="tree-indent"></span>
              <span class="tree-icon">📄</span>
              retro.htm
            </a>
            <a href={`${base}articles/css-animations-guide/`} class={`tree-item ${currentPath.includes('css-anim') ? 'selected' : ''}`}>
              <span class="tree-indent"></span>
              <span class="tree-indent"></span>
              <span class="tree-icon">📄</span>
              cssanim.htm
            </a>
            <div class="tree-item">
              <span class="tree-indent"></span>
              <span class="tree-expand">▼</span>
              <span class="tree-icon">📁</span>
              notes
            </div>
            <a href={`${base}notes/`} class={`tree-item ${isNotes && currentPath.endsWith('/notes/') ? 'selected' : ''}`}>
              <span class="tree-indent"></span>
              <span class="tree-indent"></span>
              <span class="tree-icon">📄</span>
              index.htm
            </a>
            <a href={`${base}notes/gsap-quick-tips/`} class={`tree-item ${currentPath.includes('gsap') ? 'selected' : ''}`}>
              <span class="tree-indent"></span>
              <span class="tree-indent"></span>
              <span class="tree-icon">📄</span>
              gsap.htm
            </a>
            <a href={`${base}notes/terminal-aliases/`} class={`tree-item ${currentPath.includes('terminal') ? 'selected' : ''}`}>
              <span class="tree-indent"></span>
              <span class="tree-indent"></span>
              <span class="tree-icon">📄</span>
              terminal.htm
            </a>
            <a href={`${base}notes/color-palette-generator/`} class={`tree-item ${currentPath.includes('color-palette') ? 'selected' : ''}`}>
              <span class="tree-indent"></span>
              <span class="tree-indent"></span>
              <span class="tree-icon">📄</span>
              colors.htm
            </a>
            <a href={`${base}notes/web-audio-basics/`} class={`tree-item ${currentPath.includes('web-audio') ? 'selected' : ''}`}>
              <span class="tree-indent"></span>
              <span class="tree-indent"></span>
              <span class="tree-icon">📄</span>
              audio.htm
            </a>
            <div class="tree-item">
              <span class="tree-indent"></span>
              <span class="tree-icon">📁</span>
              images
            </div>
            <div class="tree-item">
              <span class="tree-indent"></span>
              <span class="tree-icon">📁</span>
              _private
            </div>
          </div>
        </div>

        <!-- Editor Panel -->
        <div class="editor-panel">
          <div class="editor-header">
            <span class="editor-filename">{filename}</span>
            <button class="editor-close">×</button>
          </div>
          <div class="editor-content">
            <slot />
          </div>
          <div class="editor-tabs">
            <span class="editor-tab active">Normal</span>
            <span class="editor-tab">HTML</span>
            <span class="editor-tab">Preview</span>
          </div>
        </div>
      </div>

      <!-- Status Bar -->
      <div class="status-bar">
        <span class="status-section main">
          <span class="status-icon">📄</span>
          Ready
        </span>
        <span class="status-section">
          <span class="status-icon">🌐</span>
          0 seconds over 28.8
        </span>
      </div>
    </div>
  </body>
</html>
